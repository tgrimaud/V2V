# Backend Java stack - env template (TASK-INFRA-001, ADR-0038).
# Copy to ".env" next to docker-compose.yml and fill in. Ansible renders the real
# .env from secrets (TASK-OPS-002); NEVER commit a filled .env.
# Reference: docs/operations/deployment-eir-ai4cc-tst.md (Configuration per tier).

# ---- Image (registry path decided in TASK-INFRA-003 / open input #5) --------
# e.g. ghcr.io/<owner>/voice-support-backend  or  <nexus-host>/voice-support/backend
BACKEND_IMAGE=REGISTRY/voice-support-backend
IMAGE_TAG=latest

# ---- Host bind / port (backend VIP .11 load-balances t03/t04) ---------------
BACKEND_BIND=0.0.0.0
BACKEND_PORT=8080

# ---- Postgres .102 (pgvector, 768 dim) --------------------------------------
DB_URL=jdbc:postgresql://192.168.0.102:5432/voicesupport
DB_USERNAME=voicesupport
DB_PASSWORD=CHANGE_ME

# ---- Embeddings (Ollama nomic-embed-text, 768 dim) - CPU sidecar (ADR-0039) -
# Decision INFRA-003: Ollama runs as a co-located sidecar (see docker-compose.yml),
# reached over the compose network. Keep the default unless Ollama runs elsewhere.
# The model is pulled at deploy time by Ansible. Staying on Ollama keeps 768 dim
# (no vector_store recreation) and adds no cloud egress for embeddings.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_IMAGE_TAG=0.5.4
OLLAMA_CPUS=1.0
OLLAMA_MEMORY=2g
# BUG-014: the ollama sidecar is pinned to a static IP on a user-defined network and the
# backend resolves the "ollama" name via /etc/hosts (extra_hosts), so name resolution
# survives container/network churn (no aardvark-dns dependency). OLLAMA_STATIC_IP must be
# inside BACKEND_NET_SUBNET; the default subnet avoids podman's 10.89.0.0/16 pool. Override
# both only if they collide with an existing network on the VM.
OLLAMA_STATIC_IP=10.123.0.11
BACKEND_NET_SUBNET=10.123.0.0/24
# Deep readiness includes the embedding hop: /actuator/health goes DOWN (503) when the
# ollama path is broken so HAProxy drains the node. true on this tier (ollama present).
EMBEDDING_HEALTH_ENABLED=true

# ---- Chat LLM (Mistral cloud, egress per open input #2) ---------------------
LLM_PROVIDER=mistral-api
MISTRAL_API_KEY=CHANGE_ME
MISTRAL_CHAT_MODEL=mistral-small-latest

# ---- API gate (must match the voice bridge VOICE_BACKEND_API_KEY) -----------
CONVERSATION_API_KEY=CHANGE_ME

# ---- Shared conversation memory (Redis .107 - ADR-0008 / TASK-BE-021) -------
CONVERSATION_STORE=redis
REDIS_HOST=192.168.0.107
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
REDIS_TIMEOUT=2s
CONVERSATION_MEMORY_TTL_SECONDS=3600
# true only where Redis is reachable (this tier). Leave false/unset in memory mode.
REDIS_HEALTH_ENABLED=true

# ---- Knowledge base (mounted read-only from the host) -----------------------
# KB_HOST_PATH must contain a "knowledge-base/" folder (the *.md sources) and the CSV
# corpus. Ansible drops the repo's KB assets there at deploy time and triggers
# POST /api/knowledge/sync post-deploy (TASK-OPS-009). The container paths point inside
# the mount; leave them as-is.
# ADR-0048: the pilot uses the FRENCH corpus (articles-fr.csv) as the single CSV source
# (FR users -> FR-on-FR retrieval). Answer language is per-request (ADR-0031), so this
# only affects retrieval relevance. KB_CSV_LANGUAGE tags the chunks (target: a retrieval
# language filter, TASK-BE-034, lets one store serve FR+EN).
KB_HOST_PATH=./kb-assets
KB_MARKDOWN_PATH=/app/kb-assets/knowledge-base
KB_CSV_PATH=/app/kb-assets/articles-fr.csv
KB_CSV_LANGUAGE=fr

# ---- Observability (OTLP opt-in, OFF by default - ADR-0028 / TASK-OPS-007) --
# Point at the centralized pilot collector (deploy/observability/) to export metrics +
# traces. Set the two endpoints to http://<obs-host>:4318/v1/metrics and .../v1/traces,
# flip OTEL_METRICS_EXPORT_ENABLED=true and raise the sampler (e.g. 1.0 for the pilot).
OTEL_METRICS_EXPORT_ENABLED=false
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_TRACES_SAMPLER_ARG=0.0

# ---- JVM / resource sizing (vla-t03/t04 = 4 vCPU / 8 GB, shared with ollama) -
# Backend + ollama sidecar co-exist on the 8 GB VM: backend 5g/3.0, ollama 2g/1.0.
JAVA_OPTS=-XX:MaxRAMPercentage=75.0
BACKEND_CPUS=3.0
BACKEND_MEMORY=5g
