# Voice bridge stack - env template (TASK-INFRA-001, ADR-0038).
# Copy to ".env" next to docker-compose.yml and fill in. Ansible renders the real
# .env from secrets (TASK-OPS-002); NEVER commit a filled .env.
# Reference: docs/operations/deployment-eir-ai4cc-tst.md (Voice bridge).

# ---- Image (registry path per open input #5) -------------------------------
VOICE_IMAGE=REGISTRY/voice-support-voice
IMAGE_TAG=latest

# ---- Host bind / ports (voice VIP .10 load-balances t01/t02) ----------------
VOICE_BIND=0.0.0.0
VOICE_PORT=8090
# Live WebSocket concurrency ceiling per bridge (ADR-0047, TASK-WEB-038): the live socket
# rides the SAME routed :8090 at /ws (primary V1 transport, no TURN); a connection past this
# ceiling is refused with WS close 1013. Code default 8; raise/lower per VM size.
VOICE_MAX_WS_SESSIONS=8

# ---- Conversation backend (backend VIP .11) --------------------------------
VOICE_BACKEND=http
# Server *base* URL since BUG-013 (backend_factory appends /api/conversation/...).
# HAProxy binds the backend VIP .11 on :80 (verified live), so no explicit port here.
VOICE_BACKEND_URL=http://192.168.0.11
# MUST equal the backend CONVERSATION_API_KEY.
VOICE_BACKEND_API_KEY=CHANGE_ME
VOICE_BACKEND_TIMEOUT_S=30

# ---- Latency levers (TASK-WEB-022) -----------------------------------------
# Lever 1 (first-sentence streaming) + backend warm-up are now the CODE defaults (ON);
# STT pre-warm stays OFF (unvalidated idle-socket). The end-of-turn hold code default is
# the validated 350 ms — override with VOICE_END_OF_TURN_SILENCE_MS only to retune.
VOICE_BACKEND_STREAM=1
VOICE_BACKEND_WARMUP=1
VOICE_STT_PREWARM=0

# ---- Gradium STT/TTS (cloud, egress per open input #2) ---------------------
GRADIUM_API_KEY=CHANGE_ME
VOICE_STT_MODE=streaming
VOICE_TTS_MODE=streaming
# Optional: Gradium voice id used for English turns (French uses the default voice).
GRADIUM_VOICE_ID_EN=

# ---- WebRTC NAT traversal (STUN/TURN for Prodpriv clients) -----------------
# Confirm with the platform team (open input #1/#4). Comma-separated URLs.
# STUN alone works only if the client can reach the bridge's host candidate; a
# Prodpriv client behind a symmetric NAT needs a TURN relay (media is UDP + P2P,
# NOT proxied by HAProxy). TURN needs credentials; leave empty for STUN/host-only.
VOICE_STUN=
VOICE_TURN=
VOICE_TURN_USERNAME=
VOICE_TURN_CREDENTIAL=CHANGE_ME

# ---- Observability (OTLP opt-in, OFF by default - ADR-0028 / TASK-OPS-007) -
# Set OTEL_EXPORTER_OTLP_ENDPOINT to the centralized pilot collector base URL
# (http://<obs-host>:4318) to export per-turn spans. The voice.turn trace id is derived
# from the correlation id, so a turn stitches to the backend spans in one trace.
OTEL_METRICS_EXPORT_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---- Concurrency ceiling (TASK-WEB-024) ------------------------------------
# Max simultaneous live WebRTC sessions per bridge. All sessions share one asyncio
# loop, so an unbounded count degrades every call on small VMs. Offers past the cap
# get a clean HTTP 503 + Retry-After (backpressure), and the active-session gauge
# `voice.webrtc.active_sessions` is exported. Code default 8; raise/lower per VM size.
VOICE_MAX_WEBRTC_SESSIONS=8

# ---- Resource sizing (vla-t01/t02 = 2 vCPU / 4 GB) -------------------------
VOICE_CPUS=1.5
VOICE_MEMORY=3g
