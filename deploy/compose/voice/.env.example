# Voice bridge stack - env template (TASK-INFRA-001, ADR-0038).
# Copy to ".env" next to docker-compose.yml and fill in. Ansible renders the real
# .env from secrets (TASK-OPS-002); NEVER commit a filled .env.
# Reference: docs/operations/deployment-eir-ai4cc-tst.md (Voice bridge).

# ---- Image (registry path per open input #5) -------------------------------
VOICE_IMAGE=REGISTRY/voice-support-voice
IMAGE_TAG=latest

# ---- Host bind / port (voice VIP .10 load-balances t01/t02) -----------------
VOICE_BIND=0.0.0.0
VOICE_PORT=8090

# ---- Conversation backend (backend VIP .11) --------------------------------
VOICE_BACKEND=http
VOICE_BACKEND_URL=http://192.168.0.11:8080
# MUST equal the backend CONVERSATION_API_KEY.
VOICE_BACKEND_API_KEY=CHANGE_ME
VOICE_BACKEND_TIMEOUT_S=30

# ---- Latency levers (pilot GO defaults) ------------------------------------
VOICE_BACKEND_STREAM=1
VOICE_BACKEND_WARMUP=1
VOICE_STT_PREWARM=0

# ---- Gradium STT/TTS (cloud, egress per open input #2) ---------------------
GRADIUM_API_KEY=CHANGE_ME
VOICE_STT_MODE=streaming
VOICE_TTS_MODE=streaming
# Optional: Gradium voice id used for English turns (French uses the default voice).
GRADIUM_VOICE_ID_EN=

# ---- WebRTC NAT traversal (STUN/TURN URLs for Prodpriv clients) ------------
# Confirm with the platform team (open input #1/#4). Space-separated URLs.
VOICE_STUN=

# ---- Observability (OTLP opt-in, OFF by default - ADR-0028) ----------------
OTEL_METRICS_EXPORT_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---- Resource sizing (vla-t01/t02 = 2 vCPU / 4 GB) -------------------------
VOICE_CPUS=1.5
VOICE_MEMORY=3g
