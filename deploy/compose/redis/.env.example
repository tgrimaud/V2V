# Redis stack - env template (TASK-INFRA-001, ADR-0008).
# Copy to ".env" next to docker-compose.yml and fill in. Ansible renders the real
# .env from secrets (TASK-OPS-002); NEVER commit a filled .env.
# Skip this stack entirely if the platform provides Redis natively (open input #8).

REDIS_IMAGE_TAG=7-alpine

# ---- Bind / port ------------------------------------------------------------
REDIS_BIND=0.0.0.0
REDIS_PORT=6379

# ---- Auth (must match the backend REDIS_PASSWORD) ---------------------------
REDIS_PASSWORD=CHANGE_ME

# ---- Memory sizing (vlb-t02 = 2 vCPU / 4 GB) --------------------------------
# maxmemory < container memory limit; noeviction keeps active sessions.
REDIS_MAXMEMORY=2gb
REDIS_CPUS=1.5
REDIS_MEMORY=3g
