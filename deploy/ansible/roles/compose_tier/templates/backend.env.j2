# Managed by Ansible (TASK-OPS-002) - do not edit on the host. Rendered from
# group_vars/backend.yml + group_vars/all/vault.yml. Mirrors backend/.env.example.
BACKEND_IMAGE={{ registry }}/{{ registry_namespace }}/voice-support-backend
IMAGE_TAG={{ image_tag }}

BACKEND_BIND={{ backend_bind }}
BACKEND_PORT={{ backend_port }}

DB_URL={{ db_url }}
DB_USERNAME={{ db_username }}
DB_PASSWORD={{ vault_db_password }}

OLLAMA_BASE_URL={{ ollama_base_url }}
OLLAMA_EMBEDDING_MODEL={{ ollama_embedding_model }}
OLLAMA_IMAGE_TAG={{ ollama_image_tag }}
OLLAMA_CPUS={{ ollama_cpus }}
OLLAMA_MEMORY={{ ollama_memory }}

LLM_PROVIDER={{ llm_provider }}
MISTRAL_API_KEY={{ vault_mistral_api_key }}
MISTRAL_CHAT_MODEL={{ mistral_chat_model }}

CONVERSATION_API_KEY={{ vault_conversation_api_key }}

CONVERSATION_STORE={{ conversation_store }}
REDIS_HOST={{ redis_host }}
REDIS_PORT={{ redis_port }}
REDIS_PASSWORD={{ vault_redis_password }}
REDIS_TIMEOUT={{ redis_timeout }}
CONVERSATION_MEMORY_TTL_SECONDS={{ conversation_memory_ttl_seconds }}
REDIS_HEALTH_ENABLED={{ redis_health_enabled | string | lower }}

KB_HOST_PATH={{ kb_host_path }}
KB_MARKDOWN_PATH=/app/kb-assets/knowledge-base
KB_CSV_PATH=/app/kb-assets/articles.csv

# Centralized OTLP export (TASK-OPS-007): enabled only when otel_collector_endpoint is set
# in group_vars (default empty -> export OFF, sampler 0.0, no collector connection attempted).
OTEL_METRICS_EXPORT_ENABLED={{ (otel_collector_endpoint | length > 0) | string | lower }}
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT={{ (otel_collector_endpoint ~ '/v1/metrics') if otel_collector_endpoint else '' }}
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT={{ (otel_collector_endpoint ~ '/v1/traces') if otel_collector_endpoint else '' }}
OTEL_TRACES_SAMPLER_ARG={{ otel_traces_sampler_arg if otel_collector_endpoint else '0.0' }}

JAVA_OPTS={{ java_opts }}
BACKEND_CPUS={{ backend_cpus }}
BACKEND_MEMORY={{ backend_memory }}
