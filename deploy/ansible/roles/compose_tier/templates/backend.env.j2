# Managed by Ansible (TASK-OPS-002) - do not edit on the host. Rendered from
# group_vars/backend.yml + group_vars/all/vault.yml. Mirrors backend/.env.example.
BACKEND_IMAGE={{ registry }}/{{ registry_namespace }}/voice-support-backend
IMAGE_TAG={{ image_tag }}

BACKEND_BIND={{ backend_bind }}
BACKEND_PORT={{ backend_port }}

DB_URL={{ db_url }}
DB_USERNAME={{ db_username }}
DB_PASSWORD={{ vault_db_password }}

OLLAMA_BASE_URL={{ ollama_base_url }}
OLLAMA_EMBEDDING_MODEL={{ ollama_embedding_model }}
OLLAMA_IMAGE_TAG={{ ollama_image_tag }}
OLLAMA_CPUS={{ ollama_cpus }}
OLLAMA_MEMORY={{ ollama_memory }}
# BUG-014: stable ollama reachability (static IP + extra_hosts) + embedding-hop readiness.
OLLAMA_STATIC_IP={{ ollama_static_ip }}
BACKEND_NET_SUBNET={{ backend_net_subnet }}
EMBEDDING_HEALTH_ENABLED={{ embedding_health_enabled | string | lower }}

LLM_PROVIDER={{ llm_provider }}
MISTRAL_API_KEY={{ vault_mistral_api_key }}
MISTRAL_CHAT_MODEL={{ mistral_chat_model }}
# OpenAI (DEC-011/ADR-0051) — used only when llm_provider == openai. Key from vault (optional
# until the pilot switches). base-url is the ROOT without /v1 (Azure Foundry: .../openai).
OPENAI_API_KEY={{ vault_openai_api_key | default('') }}
OPENAI_BASE_URL={{ openai_base_url }}
OPENAI_CHAT_MODEL={{ openai_chat_model }}
OPENAI_REASONING_EFFORT={{ openai_reasoning_effort }}

CONVERSATION_API_KEY={{ vault_conversation_api_key }}

CONVERSATION_STORE={{ conversation_store }}
REDIS_HOST={{ redis_host }}
REDIS_PORT={{ redis_port }}
REDIS_PASSWORD={{ vault_redis_password }}
REDIS_TIMEOUT={{ redis_timeout }}
CONVERSATION_MEMORY_TTL_SECONDS={{ conversation_memory_ttl_seconds }}
REDIS_HEALTH_ENABLED={{ redis_health_enabled | string | lower }}

KB_HOST_PATH={{ kb_host_path }}
KB_MARKDOWN_PATH=/app/kb-assets/knowledge-base
# ADR-0048 / TASK-OPS-009: pilot loads the French corpus as the single CSV source.
KB_CSV_PATH=/app/kb-assets/{{ kb_csv_filename }}
KB_CSV_LANGUAGE={{ kb_csv_language }}
# TASK-BE-034 (ADR-0048): retrieval language filter. When true, a turn's answer language (fr/en)
# scopes retrieval to that language + the "und" unspecified sentinel, so one store can serve FR+EN
# without mixing. OFF on the single-corpus pilot; enabling it needs both corpora loaded + a re-sync.
KB_RETRIEVAL_LANGUAGE_FILTER_ENABLED={{ kb_retrieval_language_filter_enabled | string | lower }}

# Centralized OTLP export (TASK-OPS-007): enabled only when otel_collector_endpoint is set
# in group_vars (default empty -> export OFF, sampler 0.0, no collector connection attempted).
# When OFF, the endpoints fall back to the app's own valid localhost defaults (NOT empty):
# Spring Boot's OTLP *tracing* exporter has no enabled gate and is built whenever the endpoint
# property is present — an EMPTY string fails validation ("Invalid endpoint, must start with
# http://") and crashes startup. A valid URL + sampler 0.0 keeps tracing fully inert (no spans
# sampled -> no connection), matching application.yml's default (FIX: pilot first-deploy crash).
OTEL_METRICS_EXPORT_ENABLED={{ (otel_collector_endpoint | length > 0) | string | lower }}
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT={{ (otel_collector_endpoint ~ '/v1/metrics') if otel_collector_endpoint else 'http://localhost:4318/v1/metrics' }}
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT={{ (otel_collector_endpoint ~ '/v1/traces') if otel_collector_endpoint else 'http://localhost:4318/v1/traces' }}
OTEL_TRACES_SAMPLER_ARG={{ otel_traces_sampler_arg if otel_collector_endpoint else '0.0' }}

JAVA_OPTS={{ java_opts }}
BACKEND_CPUS={{ backend_cpus }}
BACKEND_MEMORY={{ backend_memory }}
