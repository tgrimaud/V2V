# Managed by Ansible (TASK-OPS-002) - do not edit on the host. Rendered from
# group_vars/voice.yml + group_vars/all/vault.yml. Mirrors voice/.env.example.
VOICE_IMAGE={{ registry }}/{{ registry_namespace }}/voice-support-voice
IMAGE_TAG={{ image_tag }}

VOICE_BIND={{ voice_bind }}
VOICE_PORT={{ voice_port }}
VOICE_WS_PORT={{ voice_ws_port }}

VOICE_BACKEND={{ voice_backend }}
VOICE_BACKEND_URL={{ voice_backend_url }}
VOICE_BACKEND_API_KEY={{ vault_conversation_api_key }}
VOICE_BACKEND_TIMEOUT_S={{ voice_backend_timeout_s }}

VOICE_BACKEND_STREAM={{ voice_backend_stream }}
VOICE_BACKEND_WARMUP={{ voice_backend_warmup }}
VOICE_STT_PREWARM={{ voice_stt_prewarm }}

GRADIUM_API_KEY={{ vault_gradium_api_key }}
VOICE_STT_MODE={{ voice_stt_mode }}
VOICE_TTS_MODE={{ voice_tts_mode }}
GRADIUM_VOICE_ID_EN={{ gradium_voice_id_en }}

VOICE_STUN={{ voice_stun }}
VOICE_TURN={{ voice_turn }}
VOICE_TURN_USERNAME={{ voice_turn_username }}
VOICE_TURN_CREDENTIAL={{ vault_turn_credential | default('') }}

# Centralized OTLP export (TASK-OPS-007): the voice runtime exports per-turn spans when
# OTEL_EXPORTER_OTLP_ENDPOINT is set (default empty -> export OFF). It ships a voice.turn
# trace whose id is derived from the correlation id, so it stitches to the backend spans.
OTEL_METRICS_EXPORT_ENABLED={{ (otel_collector_endpoint | length > 0) | string | lower }}
OTEL_EXPORTER_OTLP_ENDPOINT={{ otel_collector_endpoint }}

# Live WebRTC session cap per bridge (TASK-WEB-024): offers past it get HTTP 503 +
# Retry-After (backpressure). All sessions share one asyncio loop, so this bounds load.
VOICE_MAX_WEBRTC_SESSIONS={{ voice_max_webrtc_sessions }}

VOICE_CPUS={{ voice_cpus }}
VOICE_MEMORY={{ voice_memory }}
