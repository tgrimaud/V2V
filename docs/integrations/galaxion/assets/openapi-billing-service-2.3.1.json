                        },
                        "example": 19030000000152
                    },
                    {
                        "name": "galaxion-user-type",
                        "in": "header",
                        "description": "Galaxion user type",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "REGISTERED",
                                "PRIVILEGED",
                                "SYSTEM"
                            ],
                            "example": "SYSTEM"
                        }
                    },
                    {
                        "name": "galaxion-user-identifier",
                        "in": "header",
                        "description": "Galaxion user identifier",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "SYSTEM"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success to retrieve summary csv.",
