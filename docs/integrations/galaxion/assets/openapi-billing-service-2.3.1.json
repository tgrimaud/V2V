                    {
                        "name": "invoice_number",
                        "in": "path",
                        "description": "The invoice id",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "format": "int64"
                        },
                        "example": 12345
                    },
                    {
                        "name": "galaxion-user-type",
                        "in": "header",
                        "description": "Galaxion user type",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "PRIVILEGED",
                                "SYSTEM"
                            ],
                            "example": "SYSTEM"
                        }
                    },
                    {
                        "name": "galaxion-user-identifier",
                        "in": "header",
                        "description": "Galaxion user identifier",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "SYSTEM"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Invoice details retrieved.",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/InvoiceDetailsResponse"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Invoice not found.",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/InvoiceDetailsResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
