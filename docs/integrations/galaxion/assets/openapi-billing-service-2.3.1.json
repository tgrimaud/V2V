        "/api/v1/invoices/accounts/{account_id}/resend-eligibility": {
            "get": {
                "tags": [
                    "ResendInvoiceController"
                ],
                "description": "Get the resend paper invoice response for given accountId.",
                "operationId": "getResendInvoiceEligibilityResponse",
                "parameters": [
                    {
                        "name": "account_id",
                        "in": "path",
                        "description": "The account number",
                        "required": true,
                        "schema": {
                            "type": "string"
                        },
                        "example": 1234567
                    },
                    {
                        "name": "galaxion-user-type",
                        "in": "header",
                        "description": "Galaxion user type",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "PRIVILEGED",
                                "SYSTEM"
                            ],
                            "example": "SYSTEM"
                        }
                    },
                    {
                        "name": "galaxion-user-identifier",
                        "in": "header",
                        "description": "Galaxion user identifier",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "SYSTEM"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Resend paper invoice response received.",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/ResendInvoiceEligibilityResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/accounts/{account_id}/invoices": {
            "get": {
                "tags": [
                    "InvoiceController"
                ],
                "description": "Return the invoice history for the given billing account id.",
                "operationId": "getInvoiceHistory",
                "parameters": [
                    {
                        "name": "account_id",
                        "in": "path",
                        "description": "The account id",
                        "required": true,
                        "schema": {
                            "type": "string"
                        },
                        "example": 5432554
                    },
                    {
                        "name": "galaxion-user-type",
                        "in": "header",
                        "description": "Galaxion user type",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "REGISTERED",
                                "PRIVILEGED",
                                "SYSTEM"
                            ],
                            "example": "SYSTEM"
                        }
                    },
                    {
                        "name": "galaxion-user-identifier",
                        "in": "header",
                        "description": "Galaxion user identifier",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "SYSTEM"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success.",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/InvoiceHistoryResponse"
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized to access the bill, (Problem tile = access-not-authorized).",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/InvoiceHistoryResponse"
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Account not found, (Problem tile = account-not-found).",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/InvoiceHistoryResponse"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "ResendInvoicePostalAddressRequest": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int64",
                        "description": "The id of the address to resend invoice",
                        "example": 17
                    },
                    "firstName": {
                        "type": "string",
                        "description": "The first name of the customer",
                        "example": "Marie",
                        "minLength": 1
                    },
                    "lastName": {
                        "type": "string",
                        "description": "The last name of the customer",
                        "example": "Curie",
                        "minLength": 1
                    }
                },
                "required": [
                    "firstName",
                    "id",
                    "lastName"
                ]
            },
            "ResendInvoiceRequest": {
                "type": "object",
                "properties": {
                    "applyCharge": {
                        "type": "boolean",
                        "description": "Do you need to charge the resend ? Default value is 'true'.",
                        "example": false
                    },
                    "postalAddress": {
                        "$ref": "#/components/schemas/ResendInvoicePostalAddressRequest",
                        "description": "The postal address to resend the invoice. If null, the default address is used."
                    }
                }
            },
            "InvoiceDetailsResponse": {
                "type": "object",
                "properties": {
                    "accountId": {
                        "type": "string",
                        "description": "The account id for this invoice",
                        "example": 12312
                    },
                    "invoiceNumber": {
                        "type": "integer",
                        "format": "int64",
                        "description": "The invoice number",
                        "example": 113444
                    }
                },
                "required": [
                    "accountId",
                    "invoiceNumber"
                ]
            },
            "ResendInvoiceEligibilityResponse": {
                "type": "object",
                "properties": {
                    "amount": {
                        "type": "integer",
                        "format": "int64",
                        "description": "The amount of the reprint",
                        "example": 2000
                    },
                    "reprintAvailable": {
                        "type": "boolean"
                    }
                }
            },
            "InvoiceHistoryResponse": {
                "type": "object",
                "properties": {
                    "amount": {
                        "type": "integer",
                        "format": "int64",
                        "description": "Amount",
                        "example": 100
                    },
                    "invoiceNumber": {
                        "type": "integer",
                        "format": "int64",
                        "description": "Invoice number",
                        "example": 19030000000152
                    },
                    "invoiceDate": {
                        "type": "string",
                        "format": "date",
                        "description": "Invoice Date",
                        "example": "2019-04-08"
                    },
                    "dueDate": {
                        "type": "string",
                        "format": "date",
                        "description": "Due Date",
                        "example": "2019-04-08"
                    }
                },
                "required": [
                    "amount",
                    "dueDate",
                    "invoiceDate",
                    "invoiceNumber"
                ]
            }
        }
    }
}
