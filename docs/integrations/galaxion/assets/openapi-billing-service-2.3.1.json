    "tags": [
        {
            "name": "InvoiceController",
            "description": "API for managing invoices"
        },
        {
            "name": "ResendInvoiceController",
            "description": "API for managing resend invoice"
        }
    ],
    "paths": {
        "/api/v1/invoices/{invoice_number}/accounts/{account_id}/resend": {
            "post": {
                "tags": [
                    "ResendInvoiceController"
                ],
                "description": "Produce the PDF for the given invoice number with payer address.",
                "operationId": "resendInvoice",
                "parameters": [
                    {
                        "name": "invoice_number",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "format": "int64"
                        }
                    },
                    {
                        "name": "account_id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "galaxion-user-type",
                        "in": "header",
                        "description": "Galaxion user type",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "PRIVILEGED",
                                "SYSTEM"
                            ],
                            "example": "SYSTEM"
                        }
                    },
                    {
                        "name": "galaxion-user-identifier",
                        "in": "header",
                        "description": "Galaxion user identifier",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "SYSTEM"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ResendInvoiceRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "Success to retrieve invoice PDF."
                    },
                    "404": {
                        "description": "No invoice found, (roblem tile = invoice-not-found)."
                    },
                    "500": {
                        "description": "No archive found, (Problem tile = billing-archive-error).\nproblem during upload in S3 storage (Problem tile = upload-file-error).\n"
                    }
                }
            }
        },
        "/api/v1/invoices/{invoice_number}": {
            "get": {
                "tags": [
                    "InvoiceController"
                ],
                "description": "Get the PDF for the given invoice number.",
                "operationId": "getInvoice",
                "parameters": [
                    {
                        "name": "invoice_number",
                        "in": "path",
                        "description": "The invoice number",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "format": "int64"
                        },
                        "example": 19030000000152
                    },
                    {
                        "name": "accountId",
                        "in": "query",
                        "description": "The account id",
                        "required": true,
                        "schema": {
                            "type": "string"
                        },
                        "example": 29580600
                    },
                    {
                        "name": "optionalInvoice",
                        "in": "query",
                        "description": "If true, it download the optional version of the invoice",
                        "required": false,
                        "schema": {
                            "type": "boolean",
                            "default": false
                        },
                        "example": false
                    },
                    {
                        "name": "galaxion-user-type",
                        "in": "header",
                        "description": "Galaxion user type",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "REGISTERED",
                                "PRIVILEGED",
                                "SYSTEM"
                            ],
                            "example": "SYSTEM"
                        }
                    },
                    {
                        "name": "galaxion-user-identifier",
                        "in": "header",
                        "description": "Galaxion user identifier",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "SYSTEM"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success to retrieve invoice PDF.",
                        "content": {
                            "application/pdf": {
                                "schema": {
                                    "type": "string",
                                    "format": "binary"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Account id is missing (Problem tile = 'britebill-missing-account-id').",
                        "content": {
                            "application/pdf": {
                                "schema": {
                                    "type": "string",
                                    "format": "binary"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Britebill invoice not found (Problem tile = 'britebill-invoice-not-found').",
                        "content": {
                            "application/pdf": {
                                "schema": {
                                    "type": "string",
                                    "format": "binary"
                                }
                            }
                        }
                    },
                    "412": {
                        "description": "The billing archive file token is null (Problem tile = 'archive-file-token-is-null').",
                        "content": {
                            "application/pdf": {
                                "schema": {
                                    "type": "string",
                                    "format": "binary"
                                }
                            }
                        }
                    }
                }
            }
        },
