                            "text/csv": {
                                "schema": {
                                    "type": "string",
                                    "format": "binary"
                                }
                            }
                        }
                    },
                    "412": {
                        "description": "The billing archive file token is null (Problem tile = 'archive-file-token-is-null').",
                        "content": {
                            "text/csv": {
                                "schema": {
                                    "type": "string",
                                    "format": "binary"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/invoices/{invoice_number}/details": {
            "get": {
                "tags": [
