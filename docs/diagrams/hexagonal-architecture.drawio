<mxfile host="app.diagrams.net">
  <diagram name="Hexagonal architecture (ports and adapters)">
    <mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="950" math="0" adaptiveColors="auto" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="legend" value="&lt;b&gt;Legende&lt;/b&gt;  — trait plein = depend de   - - - trait pointille = implemente" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="520" height="30" as="geometry"/>
        </mxCell>

        <!-- Inbound REST -->
