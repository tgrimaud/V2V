          <mxGeometry x="40" y="80" width="250" height="470" as="geometry"/>
        </mxCell>
        <mxCell id="convCtrl" value="ConversationController&#xa;POST /api/conversation/ask" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="cIn"><mxGeometry x="15" y="40" width="220" height="50" as="geometry"/></mxCell>
