        <mxCell id="adminCtrl" value="AdminDashboardController&#xa;GET /api/admin/*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="cIn"><mxGeometry x="15" y="235" width="220" height="50" as="geometry"/></mxCell>
