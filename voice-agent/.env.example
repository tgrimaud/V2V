# Gradium API
GRADIUM_API_KEY=your_gradium_api_key_here
GRADIUM_VOICE_ID=your_preferred_voice_id

# Java backend (RAG)
BACKEND_URL=http://localhost:8081

# Optional: Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Port du serveur WebSocket téléphonie (Twilio Media Streams, μ-law 8kHz)
# servi par le bridge unifié (bridge_server) ET par l'agent legacy twilio_server
TWILIO_WS_PORT=8766
