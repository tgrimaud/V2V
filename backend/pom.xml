<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.1</version>
        <relativePath/>
    </parent>

    <groupId>com.voicesupport</groupId>
    <artifactId>voice-support-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>voice-support-backend</name>
    <description>Voice Support Bot — conversation answer engine (RAG over the knowledge base)</description>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <archunit.version>1.2.1</archunit.version>
        <spring-ai.version>1.0.0</spring-ai.version>
        <cucumber.version>7.18.1</cucumber.version>
        <!-- KB CSV ingestion (TASK-BE-013, ADR-0030): not managed by the Spring Boot BOM. -->
        <jsoup.version>1.22.2</jsoup.version>
        <commons-csv.version>1.14.1</commons-csv.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Observability (TASK-BE-009): Micrometer MeterRegistry + actuator metrics for
             per-slice latency (retrieval / LLM) with client-side p50/p95/p99 percentiles.
             No exporter is wired for the pilot; a Micrometer Tracing OTel bridge can be added
             later to promote the same slice timings to distributed spans (ADR-0028). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Spring AI: Ollama embeddings (nomic-embed-text, 768d) + pgvector store.
             Unused auto-configurations (chat/mistral) are excluded on the main class. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-ollama</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-vector-store-pgvector</artifactId>
        </dependency>

        <!-- Spring AI: Mistral chat (mistral-small-latest) for the LLM wording step.
             The chat model is built manually in the conversation LlmConfig; the Mistral
             chat/embedding/moderation auto-configurations are excluded on the main class
             (embeddings stay Ollama). Ollama chat is the local/offline alternative. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-mistral-ai</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- KB CSV ingestion (TASK-BE-013, ADR-0030): CsvArticleConnector.
             commons-csv = RFC-4180 parser (the HTML `content` has embedded newlines +
             escaped quotes, so a hand-rolled split is unsafe); jsoup = HTML -> plain text
             so chunks/embeddings are clean. Neither is managed by the Spring Boot BOM. -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-csv</artifactId>
            <version>${commons-csv.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>${jsoup.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- QA: Cucumber-for-Java BDD acceptance (product-observable Gherkin). -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-java</artifactId>
            <version>${cucumber.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-junit-platform-engine</artifactId>
            <version>${cucumber.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-suite</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- TASK-QA-018: mutation testing (PIT). Behind a profile so the normal
             `mvn test` loop stays fast. Scoped to the high-value deterministic domain
             (guardrails + audience classifier) — the BUG-001/BUG-005 logic where a weak
             assertion could silently pass a broken mutant. IMPORTANT: invoke via a phase so
             the tests recompile — calling the goal alone runs against stale target/test-classes:
                 mvn -Ppitest test-compile org.pitest:pitest-maven:mutationCoverage
             Report: target/pit-reports/index.html. The build targets Java 17; if PIT
             fails under a newer runtime JDK (ASM major-version), run with JAVA_HOME on a
             JDK 17. Baseline (2026-07-27): 193 mutations, 90 % killed, 93 % test strength.
             mutationThreshold=85 (below baseline) guards regressions without flaking; ratchet
             up as peripheral survivors (SentenceSegmenter, EmbeddingDomainClassifier...) are killed. -->
        <profile>
            <id>pitest</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>1.19.1</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>1.2.2</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <targetClasses>
                                <param>com.voicesupport.conversation.domain.service.*</param>
                                <param>com.voicesupport.knowledge.infrastructure.adapter.out.classifier.*</param>
                            </targetClasses>
                            <targetTests>
                                <param>com.voicesupport.conversation.domain.service.*</param>
                                <param>com.voicesupport.knowledge.infrastructure.adapter.out.classifier.*</param>
                            </targetTests>
                            <outputFormats>
                                <param>HTML</param>
                                <param>XML</param>
                            </outputFormats>
                            <timestampedReports>false</timestampedReports>
                            <mutationThreshold>85</mutationThreshold>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
