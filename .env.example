# Voice Support Bot — Environment Variables
#
# The only runnable code on `feat/restart-from-scratch` is the Python voice
# runtime under `voice-agent/`. The variables in the first section drive it.
# The "Target backend" section documents variables for the Java backend that
# lives on `main` (not runnable on this branch) and is kept for reference.

# --- Voice runtime (voice-agent, active on this branch) ---

# Gradium STT + TTS (required only for `--provider gradium`)
GRADIUM_API_KEY=your_gradium_api_key_here
# "default" (or empty) is auto-resolved to the real FR catalog voice (Elise).
GRADIUM_VOICE_ID=default
GRADIUM_LANGUAGE=fr
GRADIUM_INPUT_FORMAT=pcm_16000
# Optional overrides:
# GRADIUM_OUTPUT_FORMAT=pcm_16000
# GRADIUM_MODEL_NAME=default

# Runtime selection (CLI flags take precedence over these):
# VOICE_RUNTIME=pipecat            # pipecat (default) | stdlib
# VOICE_BACKEND=stub               # stub (default, offline) | http

# HTTP conversation backend (only when VOICE_BACKEND=http / --backend http)
# VOICE_BACKEND_URL=http://127.0.0.1:8080/answer
# VOICE_BACKEND_API_KEY=your_backend_api_key_here
# VOICE_BACKEND_TIMEOUT_S=8

# --- Target backend (Java, on `main`; not runnable on this branch) ---
# MISTRAL_API_KEY=your_mistral_api_key_here
# LLM_PROVIDER=mistral-api
# CONVERSATION_STORE=redis
# CONVERSATION_EVENT_STORE=jpa
# CONVERSATION_TTL_SECONDS=86400
# REDIS_HOST=redis
# REDIS_PORT=6379
