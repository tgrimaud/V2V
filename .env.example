# Voice Support Bot — Environment Variables

# Gradium API (STT + TTS)
GRADIUM_API_KEY=your_gradium_api_key_here
GRADIUM_VOICE_ID=default

# Backend Java
MISTRAL_API_KEY=your_mistral_api_key_here
LLM_PROVIDER=mistral-api
CONVERSATION_STORE=redis
CONVERSATION_EVENT_STORE=jpa
CONVERSATION_TTL_SECONDS=86400
REDIS_HOST=redis
REDIS_PORT=6379

# Deepgram (legacy, no longer required)
# DEEPGRAM_API_KEY=your_deepgram_api_key_here
